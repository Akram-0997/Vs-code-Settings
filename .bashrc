 # Custom developer Shortcuts
alias ginstall="pnpm install || npm install" # smart dependency installer
alias gs="git status"
alias ga="git add ."
alias gc="git commit -m"
alias gp="git push"
alias dev="pnpm dev || npm run dev"
alias cls="clear"

# Easy directory Hopping
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."